{
  "version": 1,
  "components": {
    "sa3": {},
    "images": {},
    "ltx": {}
  },
  "stages": [
    {
      "id": "audio",
      "component": "sa3",
      "argv": [
        "bash",
        "{root}/colab/run_colab.sh"
      ],
      "env": {
        "SA3_COLAB_CONFIG": "{root}/colab/generation_config.json",
        "SA3_COLAB_LOCAL_OUTPUT_DIR": "{run_dir}/audio"
      },
      "outputs": [
        "{run_dir}/audio/sa3_medium_360s.flac"
      ],
      "artifact": {
        "kind": "audio",
        "paths": [
          "{run_dir}/audio/sa3_medium_360s.flac"
        ],
        "manifest": "{run_dir}/contracts/audio.json"
      },
      "inputs": [
        "{sa3.root}/colab/generation_config.json"
      ]
    },
    {
      "id": "images",
      "component": "images",
      "argv": [
        "{python}",
        "{root}/scripts/generate_images.py",
        "{root}/config.json"
      ],
      "artifact": {
        "kind": "image",
        "paths": [
          "{images.root}/scripts/output/upscaled"
        ],
        "manifest": "{run_dir}/contracts/images.json"
      },
      "inputs": [
        "{images.root}/config.json",
        "{images.root}/scripts/prompts.json"
      ]
    },
    {
      "id": "video",
      "component": "ltx",
      "argv": [
        "{python}",
        "{root}/scripts/run_full_pipeline.py",
        "--manifest",
        "{run_dir}/video/manifest.json",
        "--image-dir",
        "{images.root}/scripts/output/upscaled",
        "--music",
        "{run_dir}/audio/sa3_medium_360s.flac"
      ],
      "outputs": [
        "{run_dir}/video/music_video.mp4"
      ],
      "artifact": {
        "kind": "video",
        "paths": [
          "{run_dir}/video/music_video.mp4"
        ],
        "manifest": "{run_dir}/contracts/video.json"
      },
      "input_contracts": [
        {
          "path": "{run_dir}/contracts/audio.json",
          "kind": "audio"
        },
        {
          "path": "{run_dir}/contracts/images.json",
          "kind": "image"
        }
      ],
      "inputs": [
        "{run_dir}/audio/sa3_medium_360s.flac",
        "{images.root}/scripts/output/upscaled"
      ]
    },
    {
      "id": "shorts",
      "component": "ltx",
      "argv": [
        "{python}",
        "-m",
        "antigravityPicker.cliV3",
        "--outputs-dir",
        "{run_dir}/video",
        "--force"
      ],
      "outputs": [
        "{run_dir}/video/shorts/v3/selections.json"
      ],
      "artifact": {
        "kind": "video",
        "paths": [
          "{run_dir}/video/shorts/v3/selections.json"
        ],
        "manifest": "{run_dir}/contracts/shorts.json"
      },
      "input_contracts": [
        {
          "path": "{run_dir}/contracts/video.json",
          "kind": "video"
        }
      ],
      "inputs": [
        "{run_dir}/video/music_video.mp4"
      ]
    }
  ]
}
