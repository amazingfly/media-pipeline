{
  "version": 1,
  "components": {
    "storybook": {},
    "images": {}
  },
  "stages": [
    {
      "id": "storybook",
      "component": "storybook",
      "argv": [
        "{python}",
        "{root}/scripts/run_storybook.py",
        "--mode",
        "colab",
        "--story",
        "{root}/sdxl_littlequeen_v1/storybook_mvp_v1/example_story.json",
        "--run-dir",
        "{run_dir}"
      ],
      "outputs": [
        "{run_dir}/story/storybook.mp4"
      ],
      "inputs": [
        "{storybook.root}/sdxl_littlequeen_v1/storybook_mvp_v1/example_story.json",
        "{storybook.root}/sdxl_littlequeen_v1/storybook_mvp_v1/lora_catalog.json"
      ],
      "artifact": {
        "kind": "story",
        "paths": [
          "{run_dir}/story/storybook.mp4",
          "{run_dir}/compiled_story.json"
        ],
        "manifest": "{run_dir}/contracts/story.json"
      }
    }
  ]
}
