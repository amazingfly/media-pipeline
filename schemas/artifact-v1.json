{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amazingfly/media-pipeline/schemas/artifact-v1.json",
  "title": "Agentic media artifact envelope v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "kind",
    "producer",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "agentic-media/artifacts"
    },
    "version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "audio",
        "image",
        "video",
        "story"
      ]
    },
    "producer": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "relative": {
            "type": "string"
          }
        }
      }
    }
  }
}
