{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pipeline checkpoint v2",
  "type": "object",
  "required": [
    "version",
    "plan_sha256",
    "provenance",
    "status",
    "stages"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance": {
      "type": "object"
    },
    "status": {
      "enum": [
        "running",
        "complete",
        "failed"
      ]
    },
    "stages": {
      "type": "object"
    }
  }
}
